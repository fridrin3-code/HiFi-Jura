#include <WiFi.h>
#include <WebServer.h>
#include <Adafruit_NeoPixel.h>
#include <driver/i2s.h>
#include <math.h>

// ===== WiFi =====
const char* ssid = "Jura";
const char* password = "Tricko4455";
WebServer server(8080);

// ===== LED =====
#define LED_PIN 16
#define LED_COUNT 10
Adafruit_NeoPixel strip(LED_COUNT, LED_PIN, NEO_GRB + NEO_KHZ800);

// ===== I2S =====
#define I2S_BCLK 26
#define I2S_LRCK 27
#define I2S_DOUT 25
#define SAMPLE_RATE 44100

// ===== Tlačítka =====
#define VOL_PLUS_PIN 32
#define VOL_MINUS_PIN 33
#define MODE_PIN 35

// ===== Globální proměnné =====
int volume = 128;
uint8_t mode = 0;
bool led_enabled = true;
unsigned long last_button_press = 0;
int current_led_count = 0;

void init_i2s() {
  i2s_config_t i2s_config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_TX),
    .sample_rate = SAMPLE_RATE,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
    .channel_format = I2S_CHANNEL_FMT_RIGHT_LEFT,
    .communication_format = (i2s_comm_format_t)(I2S_COMM_FORMAT_I2S | I2S_COMM_FORMAT_I2S_MSB),
    .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
    .dma_buf_count = 8,
    .dma_buf_len = 64,
    .use_apll = false,
    .tx_desc_auto_clear = false,
  };

  i2s_pin_config_t pin_config = {
    .bck_io_num = I2S_BCLK,
    .ws_io_num = I2S_LRCK,
    .data_out_num = I2S_DOUT,
    .data_in_num = -1
  };

  i2s_driver_install(I2S_NUM_0, &i2s_config, 0, NULL);
  i2s_set_pin(I2S_NUM_0, &pin_config);
  Serial.println("✅ I2S OK");
}

void init_leds() {
  strip.begin();
  strip.show();
  Serial.println("✅ LED OK");
}

void init_buttons() {
  pinMode(VOL_PLUS_PIN, INPUT_PULLUP);
  pinMode(VOL_MINUS_PIN, INPUT_PULLUP);
  pinMode(MODE_PIN, INPUT_PULLUP);
  Serial.println("✅ Tlačítka OK");
}

void init_wifi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  
  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 20) {
    delay(500);
    Serial.print(".");
    attempts++;
  }
  
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n✅ WiFi OK");
    Serial.print("IP: ");
    Serial.println(WiFi.localIP());
  }
}

void init_webserver() {
  server.on("/", handleRoot);
  server.on("/api/volume", handleVolume);
  server.on("/api/mode", handleMode);
  server.on("/api/led-toggle", handleLedToggle);
  server.on("/api/status", handleStatus);
  
  server.begin();
  Serial.println("✅ Web server OK");
  Serial.print("http://");
  Serial.print(WiFi.localIP());
  Serial.println(":8080");
}

void handleRoot() {
  String html = R"(
<!DOCTYPE html>
<html>
<head>
  <title>Hi-fi Jura</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: Arial; background: #1e1e2e; color: #fff; text-align: center; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: rgba(50,50,70,0.9); border-radius: 20px; padding: 30px; }
    h1 { color: #ff6b6b; }
    .slider { width: 100%; height: 8px; border-radius: 5px; background: #555; }
    button { background: #ff6b6b; color: white; border: none; padding: 12px 30px; margin: 10px 5px; border-radius: 25px; cursor: pointer; }
    button:hover { background: #ff5252; }
    .status { background: rgba(100,100,150,0.5); padding: 15px; border-radius: 10px; margin: 20px 0; }
  </style>
</head>
<body>
  <div class="container">
    <h1>🎵 Hi-fi Jura</h1>
    
    <h3>🔊 Hlasitost</h3>
    <input type="range" id="volumeSlider" min="0" max="255" value="128" class="slider">
    <p>Hodnota: <span id="volumeValue">128</span></p>
    
    <h3>🎨 Režim LED</h3>
    <button onclick="setMode(0)">Vizualizace</button>
    <button onclick="setMode(1)">Rainbow</button>
    <button onclick="setMode(2)">Pulse</button>
    
    <button onclick="toggleLeds()">LED: <span id="ledStatus">✅</span></button>
    
    <div class="status">
      <h4>📊 Status</h4>
      <p>Hlasitost: <span id="statusVolume">128</span></p>
      <p>Režim: <span id="statusMode">Vizualizace</span></p>
      <p>LED: <span id="statusLed">Zapnuto</span></p>
    </div>
  </div>

  <script>
    const volumeSlider = document.getElementById('volumeSlider');
    volumeSlider.addEventListener('input', () => {
      document.getElementById('volumeValue').textContent = volumeSlider.value;
      fetch('/api/volume?value=' + volumeSlider.value);
    });

    function setMode(m) {
      fetch('/api/mode?mode=' + m);
      const modes = ['Vizualizace', 'Rainbow', 'Pulse'];
      document.getElementById('statusMode').textContent = modes[m];
    }

    function toggleLeds() {
      fetch('/api/led-toggle').then(r => r.json()).then(d => {
        document.getElementById('ledStatus').textContent = d.enabled ? '✅' : '❌';
        document.getElementById('statusLed').textContent = d.enabled ? 'Zapnuto' : 'Vypnuto';
      });
    }
  </script>
</body>
</html>
  )";
  server.send(200, "text/html", html);
}

void handleVolume() {
  if (server.hasArg("value")) {
    volume = server.arg("value").toInt();
    current_led_count = map(volume, 0, 255, 0, LED_COUNT);
    server.send(200, "text/plain", "OK");
  }
}

void handleMode() {
  if (server.hasArg("mode")) {
    mode = server.arg("mode").toInt();
    server.send(200, "text/plain", "OK");
  }
}

void handleLedToggle() {
  led_enabled = !led_enabled;
  String response = "{\"enabled\":" + String(led_enabled ? "true" : "false") + "}";
  server.send(200, "application/json", response);
}

void handleStatus() {
  String response = "{\"volume\":" + String(volume) + ",\"mode\":" + String(mode) + ",\"led_enabled\":" + String(led_enabled ? "true" : "false") + "}";
  server.send(200, "application/json", response);
}

void visualize_bass() {
  strip.clear();
  for (int i = 0; i < current_led_count; i++) {
    uint8_t red = map(volume, 0, 255, 100, 255);
    uint8_t blue = map(volume, 0, 255, 200, 50);
    strip.setPixelColor(i, strip.Color(red, 0, blue));
  }
  strip.show();
}

void rainbow_effect() {
  static uint8_t hue = 0;
  strip.clear();
  for (int i = 0; i < LED_COUNT; i++) {
    uint32_t color = strip.ColorHSV((hue + i * 255 / LED_COUNT) & 0xFFFF, 255, 200);
    strip.setPixelColor(i, color);
  }
  hue += 5;
  strip.show();
}

void pulse_effect() {
  static uint8_t pulse = 0;
  strip.clear();
  uint8_t brightness_pulse = abs(sin(pulse * 0.1)) * 200 + 50;
  for (int i = 0; i < LED_COUNT; i++) {
    strip.setPixelColor(i, strip.Color(brightness_pulse, 0, 100));
  }
  pulse++;
  strip.show();
}

void check_buttons() {
  unsigned long now = millis();
  if (now - last_button_press < 200) return;
  
  if (digitalRead(VOL_PLUS_PIN) == LOW) {
    volume = min(volume + 15, 255);
    current_led_count = map(volume, 0, 255, 0, LED_COUNT);
    last_button_press = now;
    Serial.print("VOL+: ");
    Serial.println(volume);
  }
  
  if (digitalRead(VOL_MINUS_PIN) == LOW) {
    volume = max(volume - 15, 0);
    current_led_count = map(volume, 0, 255, 0, LED_COUNT);
    last_button_press = now;
    Serial.print("VOL-: ");
    Serial.println(volume);
  }
  
  if (digitalRead(MODE_PIN) == LOW) {
    mode = (mode + 1) % 3;
    last_button_press = now;
    Serial.print("MODE: ");
    Serial.println(mode);
  }
}

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println("\n🎵 Hi-fi Jura - Startování...\n");
  
  init_leds();
  init_buttons();
  init_i2s();
  init_wifi();
  init_webserver();
  
  Serial.println("\n✅ Systém připraven!\n");
}

void loop() {
  server.handleClient();
  check_buttons();
  
  if (led_enabled) {
    switch (mode) {
      case 0: visualize_bass(); break;
      case 1: rainbow_effect(); delay(30); break;
      case 2: pulse_effect(); delay(50); break;
    }
  } else {
    strip.clear();
    strip.show();
  }
  
  delay(10);
}